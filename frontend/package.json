{
  "name": "origami-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-6010} -H 0.0.0.0",
    "start": "if [ -f .next/BUILD_ID ]; then next start -p ${PORT:-6010} -H 0.0.0.0; else next dev -p ${PORT:-6010} -H 0.0.0.0; fi",
    "prod": "next start -p ${PORT:-6010} -H 0.0.0.0",
    "build": "next build",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.454.0",
    "clsx": "2.1.1",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.14",
    "postcss": "8.4.47",
    "autoprefixer": "10.4.20"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15"
  }
}
