0:["e97I8kf3pZqM8GVs_K9lH",[[["",{"children":["insights",{"children":[["slug","why-mobile-first-is-still-the-right-call-in-2026","d"],{"children":["__PAGE__?{\"slug\":\"why-mobile-first-is-still-the-right-call-in-2026\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["insights",{"children":[["slug","why-mobile-first-is-still-the-right-call-in-2026","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"data-testid":"insight-page-why-mobile-first-is-still-the-right-call-in-2026","children":[["$","section",null,{"className":"relative pt-36 md:pt-44 pb-16 border-b border-ink-line overflow-hidden bg-paper","children":[["$","div",null,{"className":"absolute inset-0 dotted opacity-40"}],["$","div",null,{"className":"relative max-w-[1080px] mx-auto px-6 md:px-10","children":[["$","$L2",null,{"href":"/insights","className":"inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.25em] text-ink-muted hover:text-signal mb-8","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left w-4 h-4","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}]," All insights"]}],["$","div",null,{"className":"font-mono text-[11px] uppercase tracking-[0.25em] text-signal mb-5","children":["/// ","Mobile"," · ","2026-02-10"," · ","6 min read"]}],["$","h1",null,{"className":"font-display text-4xl md:text-6xl lg:text-7xl font-black leading-[0.95] tracking-tightest","children":"Why mobile-first is still the right call in 2026"}],["$","p",null,{"className":"mt-8 text-ink-soft text-lg md:text-xl leading-relaxed","children":"The web got fast again and AI got useful, but the first tap of the day still happens on a phone. Here's how we think about mobile-first for culture-forward brands."}]]}]]}],["$","article",null,{"className":"py-16 md:py-24 border-b border-ink-line bg-white","children":["$","div",null,{"className":"max-w-[760px] mx-auto px-6 md:px-10 text-ink-soft text-lg leading-[1.8] space-y-5","children":[[["$","p",null,{"children":"Every year for the last five years, someone has predicted the end of the mobile app. Progressive web apps would replace it. Then voice would. Then AR. Then AI agents would just transact on our behalf and we wouldn't tap anything at all."}],["$","p",null,{"children":"Five years on, the home screen still wins. The first thing most people touch in the morning is a glass rectangle, and the apps on it are where commerce, culture and money actually happen. The browser is a fallback. The agent is a feature inside the app, not the replacement for it."}],["$","h2",null,{"className":"font-display text-2xl md:text-3xl font-black tracking-tightest leading-tight text-ink mt-12 mb-2","children":"Why mobile is still the home for the brand"}],["$","p",null,{"children":"When a brand has a relationship with a real audience — fans, players, traders, travellers — that relationship lives where the audience already lives. Push notifications, biometric login, offline state, the lock-screen presence, App Store ranking, in-app purchases, native gestures: none of these have a real web equivalent in 2026, and most of them got better in the last 12 months, not worse."}],["$","p",null,{"children":"We've shipped mobile apps for hip-hop fans (HipHopGrails), fantasy bettors (PlaySQOR), retail traders (RealProfits), shoppers (VideoShops, GetCashback) and beach travellers (OnlyBeaches). The variable changes, the conclusion doesn't: the engaged user comes back through the home screen, not through a search box."}],["$","h2",null,{"className":"font-display text-2xl md:text-3xl font-black tracking-tightest leading-tight text-ink mt-12 mb-2","children":"What mobile-first actually means now"}],["$","p",null,{"children":"It does not mean \"build mobile first, then a website\". It means designing the experience around the constraints and capabilities of a phone in someone's hand — and letting those constraints shape product decisions across every surface, including web."}],["$","p",null,{"children":"In practice, that's a checklist we use early in any engagement: cold start under 1.5 seconds; 60fps scroll on lists that matter; biometric login by default; deep-linking that survives push, email and shared URL; offline-first state on any screen the user might open in transit; analytics on tap latency, not just session length."}],["$","h2",null,{"className":"font-display text-2xl md:text-3xl font-black tracking-tightest leading-tight text-ink mt-12 mb-2","children":"Where AI fits in"}],["$","p",null,{"children":"AI doesn't replace the app — it rides inside it. The most engaging AI features we've shipped this year are inside mobile apps: Wholosophy's coach, RealProfits' trade co-pilot, GetCashback's offer ranker. Each one is a feature, not a product, and each one needed the surrounding app to make it useful."}],["$","p",null,{"children":"If you remove the app, AI alone is a chatbot with a brand on top. If you keep the app and add AI, you get a product that feels like the future."}],["$","h2",null,{"className":"font-display text-2xl md:text-3xl font-black tracking-tightest leading-tight text-ink mt-12 mb-2","children":"The takeaway"}],["$","p",null,{"children":"Mobile-first in 2026 isn't about choosing a platform. It's about being honest that the home screen is still the most valuable real-estate your brand will ever rent — and building like you intend to live there."}]],["$","div",null,{"className":"pt-12 mt-12 border-t border-ink-line flex flex-wrap items-center justify-between gap-4","children":[["$","div",null,{"className":"font-mono text-[11px] uppercase tracking-[0.25em] text-ink-muted","children":"Want this kind of work on your roadmap?"}],["$","$L2",null,{"href":"/contact","className":"btn-pill btn-primary text-sm","data-testid":"insight-cta","child